# config/ holds the Google API key and data/ the cached reviews. Neither is
# ever meant to be fetched over HTTP; if PHP were disabled the key would
# otherwise be served as plain text.
RedirectMatch 404 ^/(config|data)/
RedirectMatch 404 ^/api/google-reviews-config\.php$

# Second, independent guard: RedirectMatch needs mod_alias, this does not.
<Files "google-reviews-config.php">
  Require all denied
</Files>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  # HTML should not be cached aggressively
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache static assets aggressively (we use versioned URLs)
  <FilesMatch "\.(?:css|js|png|jpe?g|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>


  Header append Vary "Accept-Encoding"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
